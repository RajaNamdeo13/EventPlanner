# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
# If MongoDB is not running, the application automatically uses resilient local JSON storage!
MONGO_URI=mongodb://127.0.0.1:27017/event_planner

# Admin Dashboard Security PIN
ADMIN_PIN=admin123

# Email Notifications (Optional - leaves mock logging if empty)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
